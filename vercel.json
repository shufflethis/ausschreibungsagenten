{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://app.ausschreibungsagenten.de" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
            ]
        },
        {
            "source": "/",
            "headers": [
                { "key": "Vary", "value": "Accept, Accept-Encoding, User-Agent" },
                { "key": "Link", "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\", </.well-known/api-catalog>; rel=\"api-catalog\"" }
            ]
        },
        {
            "source": "/.well-known/api-catalog",
            "headers": [
                { "key": "Content-Type", "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\"" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        },
        {
            "source": "/openapi.json",
            "headers": [
                { "key": "RateLimit-Limit", "value": "600" },
                { "key": "RateLimit-Remaining", "value": "599" },
                { "key": "RateLimit-Reset", "value": "3600" }
            ]
        },
        {
            "source": "/mcp",
            "headers": [
                { "key": "RateLimit-Limit", "value": "600" },
                { "key": "RateLimit-Remaining", "value": "599" },
                { "key": "RateLimit-Reset", "value": "3600" }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                { "key": "RateLimit-Limit", "value": "600" },
                { "key": "RateLimit-Remaining", "value": "599" },
                { "key": "RateLimit-Reset", "value": "3600" }
            ]
        },
        {
            "source": "/feeds/(.*)",
            "headers": [
                { "key": "Content-Type", "value": "application/x-ndjson; charset=utf-8" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/video/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400" }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/about",
            "destination": "/ueber-uns",
            "permanent": true
        },
        {
            "source": "/privacy",
            "destination": "/datenschutz",
            "permanent": true
        },
        {
            "source": "/contact",
            "destination": "/#kontakt",
            "permanent": true
        },
        {
            "source": "/kontakt",
            "destination": "/#kontakt",
            "permanent": true
        },
        {
            "source": "/imprint",
            "destination": "/impressum",
            "permanent": true
        },
        {
            "source": "/developers",
            "destination": "/entwickler",
            "permanent": true
        },
        {
            "source": "/developer",
            "destination": "/entwickler",
            "permanent": true
        },
        {
            "source": "/docs",
            "destination": "https://api.ausschreibungsagenten.de/docs",
            "permanent": false
        },
        {
            "source": "/preise",
            "destination": "/#preise",
            "permanent": true
        },
        {
            "source": "/pricing",
            "destination": "/#preise",
            "permanent": true
        },
        {
            "source": "/tarife",
            "destination": "/#preise",
            "permanent": true
        },
        {
            "source": "/funktionen",
            "destination": "/#funktionen",
            "permanent": true
        },
        {
            "source": "/features",
            "destination": "/#funktionen",
            "permanent": true
        },
        {
            "source": "/wie-es-funktioniert",
            "destination": "/#prozess",
            "permanent": true
        },
        {
            "source": "/how-it-works",
            "destination": "/#prozess",
            "permanent": true
        },
        {
            "source": "/faq",
            "destination": "/#faq",
            "permanent": true
        },
        {
            "source": "/branchen",
            "destination": "/#branchen",
            "permanent": true
        },
        {
            "source": "/api",
            "destination": "/entwickler",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/index.md",
            "destination": "/api/agent-view"
        },
        {
            "source": "/.well-known/mcp.json",
            "destination": "/.well-known/mcp/server-card.json"
        },
        {
            "source": "/.well-known/mcp/server.json",
            "destination": "/.well-known/mcp/server-card.json"
        },
        {
            "source": "/server.json",
            "destination": "/.well-known/mcp/server-card.json"
        },
        {
            "source": "/openapi.json",
            "destination": "/api/openapi-proxy"
        },
        {
            "source": "/mcp",
            "destination": "https://api.ausschreibungsagenten.de/mcp"
        },
        {
            "source": "/api/a2a",
            "destination": "https://api.ausschreibungsagenten.de/api/a2a"
        },
        {
            "source": "/api/v1/(.*)",
            "destination": "https://api.ausschreibungsagenten.de/api/v1/$1"
        },
        {
            "source": "/.well-known/agent-card.json",
            "destination": "https://api.ausschreibungsagenten.de/.well-known/agent-card.json"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/checkout-erfolg",
            "destination": "/index.html"
        },
        {
            "source": "/login",
            "destination": "/index.html"
        },
        {
            "source": "/login/postfach",
            "destination": "/index.html"
        },
        {
            "source": "/login/abgelaufen",
            "destination": "/index.html"
        },
        {
            "source": "/anmeldung-bestaetigen",
            "destination": "/index.html"
        },
        {
            "source": "/konto",
            "destination": "/index.html"
        },
        {
            "source": "/abrechnung",
            "destination": "/index.html"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/api/not-found"
        }
    ]
}
